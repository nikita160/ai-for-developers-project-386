{
  "name": "ai-for-developers-project-386",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "contract": "tsp compile contract && openapi-ts",
    "contract:check": "npm run contract && git diff --exit-code -- contract/openapi.yaml src/lib/api/generated && test -z \"$(git ls-files --others --exclude-standard -- contract src/lib/api/generated)\"",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run test && npm run contract:check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.97.3",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi3": "^1.17.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
